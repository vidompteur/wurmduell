{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "npm test": "allow",
      "npm run build": "allow"
    }
  }
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b-q4_K_M": {
          "name": "Qwen3.5 9B Q4",
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "presence_penalty": 0,
            "repeat_penalty": 1.0
          }
        }
      }
    }
  },
  "model": "ollama/qwen3.5:9b-q4_K_M"
}
