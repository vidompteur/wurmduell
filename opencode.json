{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "npm test": "allow",
      "npm run build": "allow"
    }
  }
}
